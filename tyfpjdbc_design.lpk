<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="tyfpjdbc_design"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="TyFPJDBC"/>
    <Description Value="TyFPJDBC generic JDBC design-time components"/>
    <License Value="MPL-2.0"/>
    <Version Major="0" Minor="9" Release="1" Build="0"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="units/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
        <OtherUnitFiles Value="src/core;src/db;src/lcl"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="$(IDEBuildOptions)"/>
      </Other>
    </CompilerOptions>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="BuildIntf"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <Files>
      <Item>
        <Filename Value="src/lcl/TyFPJDBC.LCL.Conn.pas"/>
        <UnitName Value="TyFPJDBC.LCL.Conn"/>
      </Item>
      <Item>
        <Filename Value="src/lcl/TyFPJDBC.LCL.Query.pas"/>
        <UnitName Value="TyFPJDBC.LCL.Query"/>
      </Item>
      <Item>
        <Filename Value="src/lcl/TyFPJDBC.LCL.Wizard.pas"/>
        <UnitName Value="TyFPJDBC.LCL.Wizard"/>
      </Item>
      <Item>
        <Filename Value="src/lcl/TyFPJDBC.LCL.ConnDialog.pas"/>
        <UnitName Value="TyFPJDBC.LCL.ConnDialog"/>
      </Item>
      <Item>
        <Filename Value="src/lcl/TyFPJDBC.LCL.CustomDriver.pas"/>
        <UnitName Value="TyFPJDBC.LCL.CustomDriver"/>
      </Item>
      <Item>
        <Filename Value="src/lcl/tyfpjdbcreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="tyfpjdbcreg"/>
      </Item>
    </Files>
  </Package>
</CONFIG>
